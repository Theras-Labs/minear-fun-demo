# MINEAR settings (folder: minear-r3f). Every value has a default in the code, so the game runs with no env file.
# To change a value: copy this file to minear-r3f/.env.local (it is gitignored) and remove the # of the line.
# Vite reads the VITE_ lines when it starts (restart `npm run dev:testnet` after a change).
# bun reads the MINEAR_ lines when the server or a tool starts (the 8787 server restarts by itself on a code
# change, not on an env change: restart it).
# Secrets do not go here: account keys stay in minear-r3f/server/.keys/<network>/.

# ---- the game page (Vite) ----

# Our own NEAR Auth client id (Auth0), from NEAR Auth's production form: https://form.typeform.com/to/VWHjf3HV
# Empty: NEAR's shared testnet client, which works only on http://localhost:3000 (npm run dev:testnet).
# VITE_NEAR_AUTH_CLIENT_ID=

# testnet (default) or mainnet
# VITE_NEAR_NETWORK=testnet

# The MINEAR server of the testnet page, and of the dev-only Demo cheat page (local chain)
# VITE_MINEAR_SERVER=http://127.0.0.1:8787
# VITE_MINEAR_LOCAL_SERVER=http://127.0.0.1:8788

# ---- the MINEAR server and tools (bun) ----

# testnet (default), local (the NEAR sandbox chain on this machine) or mainnet
# MINEAR_NETWORK=testnet
# MINEAR_RPC=https://test.rpc.fastnear.com
# MINEAR_SERVER_HOST=127.0.0.1
# MINEAR_SERVER_PORT=8787
# setup.ts: the root account (npm run near:setup passes --root minear.testnet)
# MINEAR_ROOT=minear.testnet
# bots.ts: the server the bots use
# MINEAR_SERVER=http://127.0.0.1:8787

# Relayer budget (minear-r3f/server/src/budget.ts). Amounts in NEAR.
# Game calls the relayer pays for per UTC day, all players together (0 = no cap). Default: testnet 24000,
# mainnet 2400, local chain no cap. Each player also has the contract's daily_free (240 on testnet).
# MINEAR_RELAY_DAILY_CAP=24000
# Top up the contract from the root when its free balance (not locked for storage) is under this.
# MINEAR_CONTRACT_MIN_FREE=1
# MINEAR_CONTRACT_TOPUP=2
# Top up the relay account from the root when its balance is under this.
# MINEAR_RELAY_MIN=1
# MINEAR_RELAY_TOPUP=2
# Most NEAR all top-ups of one UTC day may send.
# MINEAR_TOPUP_DAY_MAX=10

# Merchant voices (NEAR AI Cloud). The key goes in minear-r3f/server/.keys/near-ai.json, not here.
# MINEAR_AI_URL=https://cloud-api.near.ai/v1
# MINEAR_AI_MODEL=Qwen/Qwen3.8-27B
# MINEAR_AI_MAX_PER_HOUR=600
